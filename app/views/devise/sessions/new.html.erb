<section class="hero is-primary is-fullheight">
  <div class="hero-body">
    <div class="container ">
      <div class="columns is-centered">
        <div class="column is-4">
          <div class="box">
            <div class="field has-text-centered">
              <strong>Log in</strong>
            </div>

                <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
                  <div class="field">
                    <p><%= f.label :email, class: "label"  %></p>
                    <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %></p>
                  </div>

                  <div class="field">
                    <p><%= f.label :password, class: "label"  %></p>
                    <p><%= f.password_field :password, autocomplete: "current-password", class: "input" %></p>
                  </div>

                  <% if devise_mapping.rememberable? %>
                    <div class="field">
                      <p><%= f.check_box :remember_me %></p>
                      <p><%= f.label :remember_me, class: "label" %></p>
                    </div>
                  <% end %>

                  <div class="field">
                    <%= f.submit "Log in", class: "button is-danger is-fullwidth" %>
                  </div>
                <% end %>


                <%# link_to 'Sign in with Facebook', user_facebook_omniauth_authorize_path, class: "button is-primary is-fullwidth" %>
                <%= render "devise/shared/links" %>


          </div>
        </div>
      </div>
    </div>
  </div>
</section>
