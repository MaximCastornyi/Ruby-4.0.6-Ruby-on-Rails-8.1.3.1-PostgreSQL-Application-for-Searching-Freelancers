<% end %>

<section class="hero is-medium" style="background: url('<%= image_path("home/background.png") %>') center / cover no-repeat;">
  <div class="hero-body">
    <div class="container">
      <h1 class="title has-text-white" style="text-shadow: 2px 2px 8px rgba(239, 68, 68, 0.8);">
        Find the Perfect Freelance Services <br>
        For Your Business
      </h1>

      <%= form_tag search_path, method: :get, class: "field has-addons" do %>
        <div class="control has-icons-left">
          <span class="icon is-small is-left">
            <i class="fa fa-search"></i>
          </span>
          <%= text_field_tag 'q', '', class: "input", placeholder: "Try 'logo design'" %>
        </div>
        <div class="control">
          <button class="button is-primary" type="submit">Search</button>
        </div>
      <% end %>
    </div>
  </div>
</section>


<br/>
<br/>

