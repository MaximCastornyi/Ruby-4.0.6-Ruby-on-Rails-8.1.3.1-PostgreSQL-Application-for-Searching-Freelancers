<style>
/* Footer Styles */
.footer-section {
  background-color: #111827; /* Dark elegant theme */
  color: #9ca3af;
  padding: 60px 0 20px 0;
  margin-top: 80px;
  font-family: inherit;
}

.footer-top {
  border-bottom: 1px solid #1f2937;
  padding-bottom: 40px;
}

.footer-title {
  color: #ffffff;
  font-size: 1.5rem;
  font-weight: 800;
  margin-bottom: 15px;
  letter-spacing: -0.5px;
}

.footer-subtitle {
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 15px;
}

.footer-text {
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 20px;
}

/* Links */
.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 10px;
}

.footer-links a {
  color: #9ca3af;
  text-decoration: none;
  transition: color 0.2s ease, padding-left 0.2s ease;
  font-size: 0.95rem;
}

.footer-links a:hover {
  color: #e53e3e; /* Red accent matching your page */
  padding-left: 4px;
}

/* SVG Social Icons */
.footer-socials {
  display: flex;
  gap: 12px;
}

.footer-socials a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  background-color: #1f2937;
  color: #ffffff;
  border-radius: 50%;
  text-decoration: none;
  transition: all 0.3s ease;
}

.footer-socials a svg {
  display: block;
}

.footer-socials a:hover {
  background-color: #e53e3e;
  transform: translateY(-3px);
  color: #ffffff;
}

/* Newsletter Form */
.footer-input {
  background-color: #1f2937 !important;
  border: 1px solid #374151 !important;
  color: #ffffff !important;
  border-radius: 4px 0 0 4px !important;
}

.footer-input::placeholder {
  color: #6b7280;
}

.footer-input:focus {
  border-color: #e53e3e !important;
  box-shadow: none !important;
}

.footer-btn {
  background-color: #e53e3e !important;
  color: #ffffff !important;
  border: none !important;
  font-weight: 700 !important;
  border-radius: 0 4px 4px 0 !important;
  transition: background-color 0.2s ease !important;
}

.footer-btn:hover {
  background-color: #c53030 !important;
}

/* Bottom Bar */
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  padding-top: 25px;
  font-size: 0.875rem;
}

.footer-bottom-links a {
  color: #9ca3af;
  margin-left: 20px;
  text-decoration: none;
  transition: color 0.2s ease;
}

.footer-bottom-links a:hover {
  color: #ffffff;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .footer-bottom {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }
  
  .footer-bottom-links a {
    margin: 0 10px;
  }
}
</style>


<style>
/* Сдвиг контента надписи на 10px от левого края */
.card-content.is-overlay {
  padding-left: 10px;
}

/* Белый текст на красном фоне БЕЗ закруглённых углов */
.custom-tag {
  color: #ffffff !important;
  background-color: #e53e3e; /* Красный цвет */
  display: inline-block;
  padding: 4px 10px;
  border-radius: 0 !important; /* Убираем закругление у фонов надписей */
  font-weight: 700;
  margin-bottom: 6px;
  box-shadow: none;
  filter: none;
  text-shadow: none;
}

/* Контейнер-оболочка */
.carousel-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* Сама карусель с плавной прокруткой */
.hero-carousel {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  padding: 10px 0;
  
  /* Скрываем стандартный скроллбар */
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none;  /* IE/Edge */
}

.hero-carousel::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

/* Элемент карусели */
.carousel-item {
  flex: 0 0 calc(25% - 12px); /* Показывать по 4 карточки на широком экране */
  min-width: 240px;
  scroll-snap-align: start;
}

/* Закругление карточек и картинок */
.card-image {
  position: relative;
  border-radius: 16px; /* Закругление углов карточки */
  overflow: hidden;    /* Обрезает картинку по радиусу */
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); /* Легкая тень карточки */
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card-image:hover {
  transform: translateY(-5px); /* Эффект приподнимания при наведении */
  box-shadow: 0 12px 25px rgba(0, 0, 0, 0.25);
}

.card-image img.is-background {
  border-radius: 16px;
  object-fit: cover;
  display: block;
}

/* Стрелки навигации */
.carousel-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background-color: rgba(255, 255, 255, 0.9);
  border: none;
  border-radius: 50%;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #333;
  transition: all 0.2s ease;
}

.carousel-arrow:hover {
  background-color: #fff;
  transform: translateY(-50%) scale(1.1);
}

.carousel-arrow.prev { left: -15px; }
.carousel-arrow.next { right: -15px; }

/* Кругляшки (индикаторы) */
.carousel-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 15px;
}

.carousel-dots .dot {
  width: 10px;
  height: 10px;
  background-color: #ccc;
  border-radius: 50%;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.3s ease;
}

.carousel-dots .dot.active {
  background-color: #e53e3e; /* Акцент под красный цвет */
  transform: scale(1.3);
}

/* Адаптив под мобильные устройства */
@media (max-width: 768px) {
  .carousel-item {
    flex: 0 0 calc(80% - 10px); /* На мобильных покажем большую часть 1 карточки */
  }
  .carousel-arrow {
    display: none; /* На телефонах удобнее листать пальцем */
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const carousel = document.getElementById('carousel-category');
  const prevBtn = document.querySelector('.carousel-arrow.prev');
  const nextBtn = document.querySelector('.carousel-arrow.next');
  const dotsContainer = document.querySelector('.carousel-dots');
  const items = carousel.querySelectorAll('.carousel-item');

  if (!carousel) return;

  // 1. Прокрутка по стрелкам
  const scrollAmount = 300;

  prevBtn.addEventListener('click', () => {
    carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  nextBtn.addEventListener('click', () => {
    carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });

  // 2. Генерация кругляшков
  items.forEach((_, index) => {
    const dot = document.createElement('div');
    dot.classList.add('dot');
    if (index === 0) dot.classList.add('active');
    
    dot.addEventListener('click', () => {
      items[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
    });

    dotsContainer.appendChild(dot);
  });

  // 3. Обновление активного кругляшка при скролле
  const dots = dotsContainer.querySelectorAll('.dot');
  
  carousel.addEventListener('scroll', () => {
    let activeIndex = 0;
    let minDistance = Infinity;

    items.forEach((item, index) => {
      const box = item.getBoundingClientRect();
      const carouselBox = carousel.getBoundingClientRect();
      const distance = Math.abs(box.left - carouselBox.left);

      if (distance < minDistance) {
        minDistance = distance;
        activeIndex = index;
      }
    });

    dots.forEach(dot => dot.classList.remove('active'));
    if (dots[activeIndex]) {
      dots[activeIndex].classList.add('active');
    }
  });
});
</script>